    CTRL @ 0x00 : reg {
        27 21 ADDR
        20 16 LENGTH
        -- 15 PG_EN
        -- 01 WR_EN
        -- 00 RD_EN
    }

    CFG @ 0x04 : reg {
        -- 31 INT_EN
        21 20 RD_AJD
        18 16 RD_STROBE
        13 12 WR_ADJ
        08 00 WR_STROBE
    }

    STATE @ 0x08 : reg {
        -- 23 UK_PRT
        -- 22 NKU_PRT
        -- 21 EXKEY_EN
        -- 15 CUSTID_PRT
        -- 14 CHIPID_PRT
        -- 12 SECBOOT_PRT
        -- 11 DIS_JTAG
        -- 08 SECBOOT_EN
        -- 01 WR_DONE
        -- 00 RD_DONE
    }

    DATA @ 0x0c [8; 0x4] : reg
}

GPIO @ 0xb0010000 : block {
    PIN @ 0x00 [8; 0x100] : reg

    INT @ 0x10 [8; 0x100] : reg
    INT_SET @ 0x14 [8; 0x100] : reg
    INT_CLR @ 0x18 [8; 0x100] : reg

    MSK @ 0x20 [8; 0x100] : reg
    MSK_SET @ 0x24 [8; 0x100] : reg
    MSK_CLR @ 0x28 [8; 0x100] : reg

    PAT1 @ 0x30 [8; 0x100] : reg
    PAT1_SET @ 0x34 [8; 0x100] : reg
    PAT1_CLR @ 0x38 [8; 0x100] : reg

    PAT0 @ 0x40 [8; 0x100] : reg
    PAT0_SET @ 0x44 [8; 0x100] : reg
    PAT0_CLR @ 0x48 [8; 0x100] : reg

    FLAG @ 0x50 [8; 0x100] : reg
    FLAG_CLR @ 0x58 [8; 0x100] : reg

    PULL @ 0x70 [8; 0x100] : reg
    PULL_SET @ 0x74 [8; 0x100] : reg
    PULL_CLR @ 0x78 [8; 0x100] : reg

    Z_GID2LD @ 0x7f0 : reg

    // GPIO port C: glitch filter registers
    C_GLITCH @ 0x200 : block {
        CFG0 @ 0x800 : reg
        CFG0_SET @ 0x804 : reg
        CFG0_CLR @ 0x808 : reg

        CFG1 @ 0x810 : reg
        CFG1_SET @ 0x814 : reg
        CFG1_CLR @ 0x818 : reg

        CFG2 @ 0x820 : reg
        CFG2_SET @ 0x824 : reg
        CFG2_CLR @ 0x828 : reg

        CFG3 @ 0x830 : reg
        CFG3_SET @ 0x834 : reg
        CFG3_CLR @ 0x838 : reg
    }
}

I2C @ 0xb0050000 [3; 0x1000] : block {
    CON @ 0x00 : reg {
        -- 06 SLVDIS
        -- 05 RESTART
        -- 04 MATP
        -- 03 SATP
        02 01 SPEED : enum { 1 = 100K; 2 = 400K }
        -- 00 MD
    }

    DC @ 0x10 : reg {
        -- 10 RESTART
        -- 09 STOP
        -- 08 CMD
        07 00 DAT
    }

    INTST @ 0x2c : reg {
        -- 11 GC
        -- 10 STT
        -- 09 STP
        -- 08 ACT
        -- 07 RXDN
        -- 06 TXABT
        -- 05 RDREQ
        -- 04 TXEMP
        -- 03 TXOF
        -- 02 RXFL
        -- 01 RXOF
        -- 00 RXUF
    }

    INTMSK @ 0x30 : reg {
        -- 11 GC
        -- 10 STT
        -- 09 STP
        -- 08 ACT
        -- 07 RXDN
        -- 06 TXABT
        -- 05 RDREQ
        -- 04 TXEMP
        -- 03 TXOF
        -- 02 RXFL
        -- 01 RXOF
        -- 00 RXUF
    }

    RINTST @ 0x34 : reg {
        -- 11 GC
        -- 10 STT
        -- 09 STP
        -- 08 ACT
        -- 07 RXDN
        -- 06 TXABT
        -- 05 RDREQ
        -- 04 TXEMP
        -- 03 TXOF
        -- 02 RXFL
        -- 01 RXOF
        -- 00 RXUF
    }

    ENABLE @ 0x6c : reg {
        -- 01 ABORT
        -- 00 ACTIVE
    }

    STATUS @ 0x70 : reg {
        -- 06 SLVACT
        -- 05 MSTACT
        -- 04 RFF
        -- 03 RFNE
        -- 02 TFE
        -- 01 TFNF
        -- 00 ACT
    }

    ENBST @ 0x9c : reg {
        -- 02 SLVRDLST
        -- 01 SLVDISB
        -- 00 ACTIVE
    }

    TAR @ 0x04 : reg {
        -- 12 10BITS
        -- 11 SPECIAL
        -- 10 GC_OR_START
        09 00 ADDR
    }

    SAR @ 0x08 : reg

    SHCNT @ 0x14 : reg

    SLCNT @ 0x18 : reg

    FHCNT @ 0x1c : reg

    FLCNT @ 0x20 : reg

    RXTL @ 0x38 : reg

    TXTL @ 0x3c : reg

    TXFLR @ 0x74 : reg

    RXFLR @ 0x78 : reg

    SDAHD @ 0x7c : reg

    ABTSRC @ 0x80 : reg

    DMACR @ 0x88 : reg

    DMATDLR @ 0x8c : reg

    DMARDLR @ 0x90 : reg

    SDASU @ 0x94 : reg

    ACKGC @ 0x98 : reg

    FLT @ 0xa0 : reg

    CINT @ 0x40 : reg

    CRXUF @ 0x44 : reg

    CRXOF @ 0x48 : reg

    CTXOF @ 0x4c : reg

    CRXREQ @ 0x50 : reg

    CTXABT @ 0x54 : reg

    CRXDN @ 0x58 : reg

    CACT @ 0x5c : reg

    CSTP @ 0x60 : reg

    CSTT @ 0x64 : reg

    CGC @ 0x68 : reg
}

SSI @ 0xb0043000 : block {
    DR @ 0x00 : reg

    CR0 @ 0x04 : reg {
        19 18 TENDIAN
        17 16 RENDIAN
        -- 15 SSIE
        -- 14 TIE
        -- 13 RIE
        -- 12 TEIE
        -- 11 REIE
        -- 10 LOOP
        -- 09 RFINE
        -- 08 RFINC
        -- 07 EACLRUN
        -- 06 FSEL
        -- 04 VRCNT
        -- 03 TFMODE
        -- 02 TFLUSH
        -- 01 RFLUSH
        -- 00 DISREV
    }

    CR1 @ 0x08 : reg {
        31 30 FRMHL
        29 28 TFVCK
        27 26 TCKFI
        -- 24 ITFRM
        -- 23 UNFIN
        21 20 FMAT
        19 16 TTRG
        15 12 MCOM
        11 08 RTRG
        07 03 FLEN
        -- 01 PHA
        -- 00 POL
    }

    SR @ 0x0c : reg {
        24 16 TFIFO_NUM
        15 08 RFIFO_NUM
        -- 07 END
        -- 06 BUSY
        -- 05 TFF
        -- 04 RFE
        -- 03 TFHE
        -- 02 RFHF
        -- 01 UNDR
        -- 00 OVER
    }

    ITR @ 0x10 : reg {
        -- 15 CNTCLK
        14 00 IVLTM
    }

    ICR @ 0x14 : reg

    GR @ 0x18 : reg

    RCNT @ 0x1c : reg
}

UART @ 0xb0030000 [3; 0x1000] : block {
    URBR @ 0x00 : reg

    UTHR @ 0x00 : reg

    UDLLR @ 0x00 : reg

    UDLHR @ 0x04 : reg

    UIER @ 0x04 : reg {
        -- 04 RTOIE
        -- 03 MSIE
        -- 02 RLSIE
        -- 01 TDRIE
        -- 00 RDRIE
    }

    UIIR @ 0x08 : reg {
        07 06 FFMSEL : enum { 0 = NON_FIFO_MODE; 1 = FIFO_MODE }
        03 01 INID : enum { 0 = MODEM_STATUS; 1 = TRANSMIT_DATA_REQ; 2 = RECEIVE_DATA_READY; 3 = RECEIVE_LINE_STATUS; 6 = RECEIVE_TIME_OUT }
        -- 00 INPEND
    }

    UFCR @ 0x08 : reg {
        07 06 RDTR : enum { 0 = 1BYTE; 1 = 16BYTE; 2 = 32BYTE; 3 = 60BYTE }
        -- 04 UME
        -- 03 DME
        -- 02 TFRT
        -- 01 RFRT
        -- 00 FME
    }

    ULCR @ 0x0c : reg {
        -- 07 DLAB
        -- 06 SBK
        -- 05 STPAR
        -- 04 PARM : enum { 0 = ODD; 1 = EVEN }
        -- 03 PARE
        -- 02 SBLS : enum { 0 = 1_STOP_BIT; 1 = 2_STOP_BITS }
        01 00 WLS : enum { 0 = 5BITS; 1 = 6BITS; 2 = 7BITS; 3 = 8BITS }
    }

    UMCR @ 0x10 : reg {
        -- 07 MDCE
        -- 06 FCM
        -- 04 LOOP
        -- 01 RTS
    }

    ULSR @ 0x14 : reg {
        -- 07 FIFOE
        -- 06 TEMP
        -- 05 TDRQ
        -- 04 BI
        -- 03 FMER
        -- 02 PARER
        -- 01 OVER
        -- 00 DRY
    }

    UMSR @ 0x18 : reg {
        -- 04 CTS
        -- 00 CCTS
    }

    USPR @ 0x1c : reg

    ISR @ 0x20 : reg {
        -- 04 RDPL
        -- 03 TDPL
        -- 02 XMODE
        -- 01 RCVEIR
        -- 00 XMITIR
    }

    UMR @ 0x24 : reg

    UACR @ 0x28 : reg

    URCR @ 0x40 : reg

    UTCR @ 0x44 : reg
}

MSC @ 0xb3450000 [2; 0x10000] : block {
    CTRL @ 0x00 : reg {
        -- 15 SEND_CCSD
        -- 14 SEND_AS_CCSD
        -- 07 EXIT_MULTIPLE
        -- 06 EXIT_TRANSFER
        -- 05 START_READ_WAIT
        -- 04 STOP_READ_WAIT
        -- 03 RESET
        -- 02 START_OP
        01 00 CLOCK : enum { 0 = DO_NOTHING; 1 = STOP; 2 = START }
    }

    STAT @ 0x04 : reg {
        -- 31 AUTO_CMD12_DONE
        28 24 PINS
        -- 20 BCE
        -- 19 BDE
        -- 18 BAE
        -- 17 BAR
        -- 16 DMAEND
        -- 15 IS_RESETTING
        -- 14 SDIO_INT_ACTIVE
        -- 13 PROG_DONE
        -- 12 DATA_TRAN_DONE
        -- 11 END_CMD_RES
        -- 10 DATA_FIFO_AFULL
        -- 09 IS_READ_WAIT
        -- 08 CLOCK_EN
        -- 07 DATA_FIFO_FULL
        -- 06 DATA_FIFO_EMPTY
        -- 05 CRC_RES_ERROR
        -- 04 CRC_READ_ERROR
        03 02 CRC_WRITE_ERROR : enum { 0 = NONE; 1 = BADDATA; 2 = NOCRC }
        -- 01 TIME_OUT_RES
        -- 00 TIME_OUT_READ
    }

    CMDAT @ 0x0c : reg {
        -- 31 CCS_EXPECTED
        -- 30 READ_CEATA
        -- 27 DIS_BOOT
        -- 25 EXP_BOOT_ACK
        -- 24 BOOT_MODE
        -- 17 SDIO_PRDT
        -- 16 AUTO_CMD12
        15 14 RTRG : enum { 0 = GE16; 1 = GE32; 2 = GE64; 3 = GE96 }
        13 12 TTRG : enum { 0 = LE16; 1 = LE32; 2 = LE64; 3 = LE96 }
        -- 11 IO_ABORT
        10 09 BUS_WIDTH : enum { 0 = 1BIT; 2 = 4BIT; 3 = 8BIT }
        -- 07 INIT
        -- 06 BUSY
        -- 05 STREAM_BLOCK
        -- 04 WRITE_READ
        -- 03 DATA_EN
        02 00 RESP_FMT
    }

    IMASK @ 0x24 : reg {
        -- 31 DMA_DATA_DONE
        28 24 PINS
        -- 23 WR_ALL_DONE
        -- 20 BCE
        -- 19 BDE
        -- 18 BAE
        -- 17 BAR
        -- 16 DMAEND
        -- 15 AUTO_CMD12_DONE
        -- 14 DATA_FIFO_FULL
        -- 13 DATA_FIFO_EMPTY
        -- 12 CRC_RES_ERROR
        -- 11 CRC_READ_ERROR
        -- 10 CRC_WRITE_ERROR
        -- 09 TIME_OUT_RES
        -- 08 TIME_OUT_READ
        -- 07 SDIO
        -- 06 TXFIFO_WR_REQ
        -- 05 RXFIFO_RD_REQ
        -- 02 END_CMD_RES
        -- 01 PROG_DONE
        -- 00 DATA_TRAN_DONE
    }

    IFLAG @ 0x28 : reg {
        -- 31 DMA_DATA_DONE
        28 24 PINS
        -- 23 WR_ALL_DONE
        -- 20 BCE
        -- 19 BDE
        -- 18 BAE
        -- 17 BAR
        -- 16 DMAEND
        -- 15 AUTO_CMD12_DONE
        -- 14 DATA_FIFO_FULL
        -- 13 DATA_FIFO_EMPTY
        -- 12 CRC_RES_ERROR
        -- 11 CRC_READ_ERROR
        -- 10 CRC_WRITE_ERROR
        -- 09 TIME_OUT_RES
        -- 08 TIME_OUT_READ
        -- 07 SDIO
        -- 06 TXFIFO_WR_REQ
        -- 05 RXFIFO_RD_REQ
        -- 02 END_CMD_RES
        -- 01 PROG_DONE
        -- 00 DATA_TRAN_DONE
    }

    LPM @ 0x40 : reg {
        31 30 DRV_SEL : enum { 0 = FALL_EDGE; 1 = RISE_EDGE_DELAY_1NS; 2 = RISE_EDGE_DELAY_QTR_PHASE }
        29 28 SMP_SEL : enum { 0 = RISE_EDGE; 1 = RISE_EDGE_DELAYED }
        -- 00 ENABLE
    }

    DMAC @ 0x44 : reg {
        -- 07 MODE_SEL
        06 05 ADDR_OFFSET
        -- 04 ALIGN_EN
        03 02 INCR
        -- 01 DMASEL
        -- 00 ENABLE
    }

    CTRL2 @ 0x58 : reg {
        28 24 PIN_INT_POLARITY
        -- 04 STPRM
        02 00 SPEED : enum { 0 = DEFAULT; 1 = HIGHSPEED; 2 = SDR12; 3 = SDR25; 4 = SDR50 }
    }

    CLKRT @ 0x08 : reg

    RESTO @ 0x10 : reg

    RDTO @ 0x14 : reg

    BLKLEN @ 0x18 : reg

    NOB @ 0x1c : reg

    SNOB @ 0x20 : reg

    CMD @ 0x2c : reg

    ARG @ 0x30 : reg

    RES @ 0x34 : reg

    RXFIFO @ 0x38 : reg

    TXFIFO @ 0x3c : reg

    DMANDA @ 0x48 : reg

    DMADA @ 0x4c : reg

    DMALEN @ 0x50 : reg

    DMACMD @ 0x54 : reg

    RTCNT @ 0x5c : reg
}

