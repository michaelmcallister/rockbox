LCD @ 0xb3050000 : block {
    CFG @ 0x00 : reg {
        -- 17 INVDAT
    }

    CTRL @ 0x30 : reg {
        30 28 BURST : enum { 0 = 4WORD; 1 = 8WORD; 2 = 16WORD; 3 = 32WORD; 4 = 64WORD }
        -- 13 EOFM
        -- 12 SOFM
        -- 10 IFUM
        -- 07 QDM
        -- 06 BEDN
        -- 05 PEDN
        -- 03 ENABLE
        02 00 BPP : enum { 4 = 15BIT_OR_16BIT; 5 = 18BIT_OR_24BIT; 6 = 24BIT_COMPRESSED; 7 = 30BIT }
    }

    STATE @ 0x34 : reg {
        -- 07 QD
        -- 05 EOF
        -- 04 SOF
        -- 02 IFU
    }

    OSDCTRL @ 0x104 : reg

    BGC @ 0x10c : reg

    DAH @ 0x10 : reg

    DAV @ 0x14 : reg

    VAT @ 0x0c : reg

    VSYNC @ 0x04 : reg

    HSYNC @ 0x08 : reg

